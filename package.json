{
  "name": "@xyb-community/anal-cancer-workbench",
  "version": "0.2.10",
  "description": "本机优先的肛管癌（肛管鳞癌）放化疗副作用、肠道与排粪功能、造口生活与复查准备工作台",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "public",
    "schema",
    "scripts",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "start": "node scripts/dev-server.mjs",
    "build:version": "node scripts/build-version.mjs",
    "build:client": "node scripts/build-client.mjs",
    "demo": "node demo/build-demo-data.mjs",
    "trials": "node scripts/fetch-anal-trials-2026.mjs",
    "trials:excerpt": "node scripts/build-trials-excerpt.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check:columns": "node scripts/check-demo-columns.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:package": "node scripts/check-workbench-package.mjs .",
    "check:primer-links": "node scripts/check-primer-links.mjs",
    "check:primer-links:http": "node scripts/check-primer-links.mjs --http",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "check": "node scripts/build-version.mjs --check && node scripts/build-client.mjs --check && node scripts/check-syntax.mjs && node scripts/check-schema.mjs && node scripts/check-wording.mjs && node scripts/check-demo-columns.mjs && node --disable-warning=ExperimentalWarning --test test/*.test.mjs && node scripts/check-version.mjs && node scripts/check-workbench-package.mjs . && node scripts/check-primer-links.mjs && node scripts/check-agent-pane-contract.mjs .",
    "pack:check": "npm pack --dry-run",
    "probe:primer": "node scripts/probe-disease-primer.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/anal-cancer-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
